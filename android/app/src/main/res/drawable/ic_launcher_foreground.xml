        android:scaleX="0.7"
        android:scaleY="0.7"
        android:translateX="19"
        android:translateY="19">
        <path
            android:fillColor="@android:color/transparent"
            android:pathData="M14,60 L34,60 L46,30 L58,72 L72,42 L90,34"
