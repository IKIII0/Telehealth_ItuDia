<?xml version="1.0" encoding="utf-8"?>
<!-- Ikon splash untuk Android 12+ (windowSplashScreenAnimatedIcon).
     Android 12 men-scale SELURUH kanvas drawable ke slot ikon splash,
     sehingga besar visual ditentukan oleh rasio isi terhadap kanvas.
     Logo diberi padding (di-scale) lewat grup pembungkus di bawah agar
     tampil lebih kecil. Untuk mengatur besar-kecil ikon, ubah nilai
     android:scaleX / android:scaleY (dan translateX/Y = (120 - 120*scale)/2).
       - scale 1.0  -> penuh kanvas (paling besar)
       - scale 0.6  -> seperti sekarang (±60%)
       - makin kecil nilainya, makin kecil ikonnya. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="120dp"
    android:height="120dp"
    android:viewportWidth="120"
    android:viewportHeight="120">
    <group
        android:scaleX="0.6"
        android:scaleY="0.6"
        android:translateX="24"
        android:translateY="24">
        <!-- Bulatan putih (dibuat bulat agar pas dengan mask lingkaran Android 12) -->
        <path
            android:fillColor="@color/splash_logo_background"
            android:pathData="M0,60 A60,60 0 0 1 120,60 A60,60 0 0 1 0,60 Z" />
        <!-- Ikon medical_services (24x24) diskalakan ke 70x70 lalu dipusatkan -->
        <group
            android:scaleX="2.9167"
            android:scaleY="2.9167"
            android:translateX="25"
            android:translateY="25">
            <path
                android:fillColor="@color/splash_logo_color"
                android:pathData="M20 6h-4V4c0-1.1-.9-2-2-2h-4c-1.1 0-2 .9-2 2v2H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2zM10 4h4v2h-4V4zm6 11h-3v3h-2v-3H8v-2h3v-3h2v3h3v2z" />
        </group>
    </group>
</vector>
